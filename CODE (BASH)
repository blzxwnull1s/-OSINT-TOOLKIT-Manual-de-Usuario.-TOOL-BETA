# 29 — IP en blacklist
tool_29() {
    section "29 · IP en Listas Negras (DNSBL)"
    echo -ne "  ${W}IP a verificar: ${Y}"; read -r IP; echo -e "${N}"
    local REVERSED; REVERSED=$(echo "$IP" | awk -F. '{print $4"."$3"."$2"."$1}')
    local DNSBL_LIST=(
        "zen.spamhaus.org"
        "bl.spamcop.net"
        "dnsbl.sorbs.net"
        "b.barracudacentral.org"
        "dnsbl-1.uceprotect.net"
    )
    for BL in "${DNSBL_LIST[@]}"; do
        local RESULT; RESULT=$(dig +short "${REVERSED}.${BL}" 2>/dev/null)
        if [[ -n "$RESULT" ]]; then
            echo -e "  ${R}✗ En lista:${N} ${W}$BL${N} → $RESULT"
        else
            echo -e "  ${G}✓ OK:${N} $BL"
        fi
    done
    pause
}

