    echo -ne "  ${W}IP a analizar: ${Y}"; read -r IP; echo -e "${N}"
    local DATA; DATA=$(curl -s "https://proxycheck.io/v2/${IP}?vpn=1&asn=1")
    echo "$DATA" | jq -r ".[\"${IP}\"] | \"Proxy: \(.proxy)\nVPN: \(.vpn)\nTipo: \(.type)\nPaís: \(.country)\nISP: \(.provider)\"" 2>/dev/null | \
        while IFS= read -r l; do echo -e "  ${G}▸${N} $l"; done || \
        echo -e "  ${D}API proxycheck.io — límite 1000/día gratis${N}"
    pause
}

