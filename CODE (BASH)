        while IFS= read -r l; do echo -e "  ${G}▸${N} $l"; done
    echo ""
    echo -e "  ${C}── Gateway por defecto ──${N}"
    ip route | grep default | while IFS= read -r l; do echo -e "  ${G}▸${N} $l"; done
