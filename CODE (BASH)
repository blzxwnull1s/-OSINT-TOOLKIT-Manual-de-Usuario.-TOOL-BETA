# 24 — EXIF de imagen
tool_24() {
    section "24 · Metadatos EXIF de Imagen"
    if ! command -v exiftool &>/dev/null; then
        echo -e "  ${Y}exiftool no instalado. Instala con: sudo pacman -S perl-image-exiftool${N}"
        pause; return
    fi
    echo -ne "  ${W}Ruta de la imagen: ${Y}"; read -r IMG; echo -e "${N}"
    exiftool "$IMG" | grep -Ei "GPS|Date|Camera|Software|Author|Copyright|Location" | \
        while IFS= read -r l; do echo -e "  ${G}▸${N} $l"; done
    pause
}

# 25 — Hash de archivo
tool_25() {
    section "25 · Hash de Archivo (evidencia digital)"
    echo -ne "  ${W}Ruta del archivo: ${Y}"; read -r FILE; echo -e "${N}"
    if [[ ! -f "$FILE" ]]; then echo -e "  ${R}Archivo no encontrado${N}"; pause; return; fi
    result_line "MD5"    "$(md5sum "$FILE" | awk '{print $1}')"
    result_line "SHA1"   "$(sha1sum "$FILE" | awk '{print $1}')"
    result_line "SHA256" "$(sha256sum "$FILE" | awk '{print $1}')"
    result_line "Tamaño" "$(du -sh "$FILE" | awk '{print $1}')"
    pause
}

# 26 — Detectar VPN/Proxy
tool_26() {
