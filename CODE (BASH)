N='\033[0m'      # reset
BOLD='\033[1m'
BG_RED='\033[41m'

# ── Utilidades ───────────────────────────────────────────────
clear_screen() { clear; }

pause() {
    echo ""
    echo -e "  ${D}Presiona ENTER para continuar...${N}"
    read -r
}

header() {
    clear_screen
    echo -e "${R}"
    cat << 'EOF'

