    echo -e "  ${Y}⚠  Solo uso ético | Solo sistemas con autorización  ⚠${N}"
    echo -e "  ${D}─────────────────────────────────────────────────────${N}"
    echo ""
}

check_dep() {
    local dep=$1
    if ! command -v "$dep" &>/dev/null; then
        echo -e "  ${R}✗ Falta dependencia: ${W}$dep${N}"
        echo -e "  ${Y}  Instala con: sudo pacman -S $dep${N}"
        return 1
    fi
    return 0
}

section() {
    echo ""
    echo -e "  ${C}╔══════════════════════════════════════════╗${N}"
    echo -e "  ${C}║  ${W}${BOLD}$1${N}${C}$(printf '%*s' $((42 - ${#1})) '')║${N}"
    echo -e "  ${C}╚══════════════════════════════════════════╝${N}"
    echo ""
}

result_line() {
    echo -e "  ${G}▸${N} ${W}$1:${N} ${Y}$2${N}"
}

