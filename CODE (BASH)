# 01 — IP Info
tool_01() {
    section "01 · IP Info / Lookup"
    echo -ne "  ${W}Ingresa IP o deja vacío para tu IP: ${Y}"; read -r IP; echo -e "${N}"
    [[ -z "$IP" ]] && IP=$(curl -s ifconfig.me)
    local DATA; DATA=$(curl -s "https://ipapi.co/${IP}/json/")
    result_line "IP"           "$(echo "$DATA" | jq -r '.ip')"
    result_line "País"         "$(echo "$DATA" | jq -r '.country_name')"
    result_line "Región"       "$(echo "$DATA" | jq -r '.region')"
    result_line "Ciudad"       "$(echo "$DATA" | jq -r '.city')"
    result_line "Coordenadas"  "$(echo "$DATA" | jq -r '.latitude'), $(echo "$DATA" | jq -r '.longitude')"
    result_line "ISP"          "$(echo "$DATA" | jq -r '.org')"
    result_line "Zona horaria" "$(echo "$DATA" | jq -r '.timezone')"
    result_line "ASN"          "$(echo "$DATA" | jq -r '.asn')"
    pause
}

# 02 — GeoIP de IP
tool_02() {
    section "02 · GeoIP de IP"
    echo -ne "  ${W}Ingresa la IP: ${Y}"; read -r IP; echo -e "${N}"
    local DATA; DATA=$(curl -s "http://ip-api.com/json/${IP}")
    result_line "País"         "$(echo "$DATA" | jq -r '.country')"
    result_line "Ciudad"       "$(echo "$DATA" | jq -r '.city')"
    result_line "Lat/Lon"      "$(echo "$DATA" | jq -r '.lat'), $(echo "$DATA" | jq -r '.lon')"
    result_line "ISP"          "$(echo "$DATA" | jq -r '.isp')"
    result_line "Org"          "$(echo "$DATA" | jq -r '.org')"
    result_line "Código zip"   "$(echo "$DATA" | jq -r '.zip')"
    result_line "Zona horaria" "$(echo "$DATA" | jq -r '.timezone')"
    echo ""
    echo -e "  ${D}Google Maps: https://maps.google.com/?q=$(echo "$DATA"|jq -r '.lat'),$(echo "$DATA"|jq -r '.lon')${N}"
    pause
}

# 03 — WHOIS Dominio
tool_03() {
    section "03 · WHOIS Dominio"
    check_dep whois || { pause; return; }
    echo -ne "  ${W}Dominio (ej: ejemplo.com): ${Y}"; read -r DOM; echo -e "${N}"
    whois "$DOM" | grep -Ei "registrar|creation|expir|name server|registrant|email|status" | \
        while IFS= read -r line; do echo -e "  ${G}▸${N} ${line}"; done
    pause
}

# 04 — DNS Lookup
tool_04() {
    section "04 · DNS Lookup"
    echo -ne "  ${W}Dominio: ${Y}"; read -r DOM; echo -e "${N}"
    for TYPE in A AAAA MX NS TXT CNAME; do
        echo -e "  ${C}── $TYPE ──${N}"
        dig +short "$TYPE" "$DOM" | while IFS= read -r l; do echo -e "  ${G}▸${N} $l"; done
    done
    pause
}

# 05 — Cabeceras HTTP
tool_05() {
    section "05 · Cabeceras HTTP"
    echo -ne "  ${W}URL (con https://): ${Y}"; read -r URL; echo -e "${N}"
    curl -sI "$URL" | while IFS= read -r line; do
        echo -e "  ${G}▸${N} ${line}"
    done
    pause
}

# 06 — Ping Host
tool_06() {
    section "06 · Ping Host"
    echo -ne "  ${W}Host o IP: ${Y}"; read -r HOST; echo -e "${N}"
    ping -c 5 "$HOST"
    pause
}

# 07 — Traceroute
tool_07() {
    section "07 · Traceroute"
    check_dep traceroute || { pause; return; }
    echo -ne "  ${W}Host o IP: ${Y}"; read -r HOST; echo -e "${N}"
    traceroute "$HOST"
    pause
}

# 08 — Puertos Abiertos
tool_08() {
    section "08 · Puertos Abiertos (top 1000)"
    check_dep nmap || { pause; return; }
    echo -ne "  ${W}IP o host: ${Y}"; read -r HOST; echo -e "${N}"
    nmap -T4 --open "$HOST"
    pause
}

# 09 — Info SSL/TLS
tool_09() {
    section "09 · Info SSL/TLS"
    echo -ne "  ${W}Dominio (sin https): ${Y}"; read -r DOM; echo -e "${N}"
    echo | openssl s_client -connect "${DOM}:443" -servername "$DOM" 2>/dev/null | \
        openssl x509 -noout -text 2>/dev/null | \
        grep -E "Subject:|Issuer:|Not Before|Not After|DNS:" | \
        while IFS= read -r line; do echo -e "  ${G}▸${N} ${line}"; done
    pause
}

# 10 — Subdominios OSINT
tool_10() {
    section "10 · Subdominios OSINT (crt.sh)"
    echo -ne "  ${W}Dominio: ${Y}"; read -r DOM; echo -e "${N}"
    curl -s "https://crt.sh/?q=%25.${DOM}&output=json" | \
        jq -r '.[].name_value' 2>/dev/null | sort -u | \
        while IFS= read -r sub; do echo -e "  ${G}▸${N} $sub"; done
    pause
}

# 11 — Info número de teléfono
tool_11() {
    section "11 · Info Número Telefónico"
    echo -ne "  ${W}Número (con código país, ej +573001234567): ${Y}"; read -r NUM; echo -e "${N}"
    local DATA; DATA=$(curl -s "https://phonevalidation.abstractapi.com/v1/?api_key=demo&phone=${NUM}")
    # Si no hay API key de abstractapi, usa numverify demo
    if echo "$DATA" | jq -e '.valid' &>/dev/null; then
        result_line "Válido"    "$(echo "$DATA" | jq -r '.valid')"
        result_line "País"      "$(echo "$DATA" | jq -r '.country.name')"
        result_line "Formato"   "$(echo "$DATA" | jq -r '.format.international')"
        result_line "Tipo"      "$(echo "$DATA" | jq -r '.type')"
        result_line "Operadora" "$(echo "$DATA" | jq -r '.carrier')"
    else
        echo -e "  ${Y}Usando fuente alternativa...${N}"
        # Deducción básica desde prefijo
        local CC="${NUM:1:2}"
        echo -e "  ${G}▸${N} ${W}Número:${N} ${Y}$NUM${N}"
        echo -e "  ${G}▸${N} ${W}Prefijo internacional detectado:${N} ${Y}+${CC}${N}"
        echo -e "  ${D}  Para datos completos, registra una API key gratuita en:${N}"
        echo -e "  ${D}  https://numverify.com  o  https://app.abstractapi.com${N}"
    fi
    pause
}

# 12 — GeoIP de teléfono
tool_12() {
    section "12 · GeoLocalización de Teléfono"
    echo -ne "  ${W}Número (con código país, ej +573001234567): ${Y}"; read -r NUM; echo -e "${N}"
    echo -e "  ${Y}⚠  La geolocalización de teléfonos está limitada por ley.${N}"
    echo -e "  ${Y}   Solo se puede obtener país y operadora por prefijo.${N}"
    echo ""
    # Deducción por prefijo
    local PREFIX="${NUM:0:3}"
    case "$PREFIX" in
        +57) result_line "País" "Colombia" ;;
        +1)  result_line "País" "EE.UU. / Canadá" ;;
        +34) result_line "País" "España" ;;
        +52) result_line "País" "México" ;;
        +54) result_line "País" "Argentina" ;;
        +55) result_line "País" "Brasil" ;;
        +44) result_line "País" "Reino Unido" ;;
        +49) result_line "País" "Alemania" ;;
        +33) result_line "País" "Francia" ;;
        *)   result_line "País" "Desconocido (prefijo: ${PREFIX})" ;;
    esac
    result_line "Número" "$NUM"
    echo ""
    echo -e "  ${D}Para geolocalización precisa, se requiere orden judicial${N}"
    echo -e "  ${D}o cooperación con operadora. APIs públicas: país/región solo.${N}"
    pause
}

# 13 — Carrier / Operadora
tool_13() {
    section "13 · Carrier / Operadora de Teléfono"
    echo -ne "  ${W}Número (con código país): ${Y}"; read -r NUM; echo -e "${N}"
    local DATA; DATA=$(curl -s "https://api.telnyx.com/v2/number_lookup/${NUM}" 2>/dev/null)
    if echo "$DATA" | jq -e '.data.carrier' &>/dev/null 2>&1; then
        result_line "Operadora" "$(echo "$DATA" | jq -r '.data.carrier.name')"
        result_line "Tipo"      "$(echo "$DATA" | jq -r '.data.line_type')"
        result_line "País"      "$(echo "$DATA" | jq -r '.data.country_code')"
    else
        echo -e "  ${D}Servicio no disponible sin API key. Opciones:${N}"
        echo -e "  ${G}▸${N} https://telnyx.com (gratis con registro)"
        echo -e "  ${G}▸${N} https://numverify.com"
        echo -e "  ${G}▸${N} https://hlr-lookups.com"
    fi
    pause
}

# 14 — Análisis de Email
tool_14() {
    section "14 · Análisis de Email"
    echo -ne "  ${W}Email a analizar: ${Y}"; read -r EMAIL; echo -e "${N}"
    local DOMAIN; DOMAIN=$(echo "$EMAIL" | cut -d'@' -f2)
    result_line "Usuario"    "$(echo "$EMAIL" | cut -d'@' -f1)"
    result_line "Dominio"    "$DOMAIN"
    echo ""
    echo -e "  ${C}── Verificando registros MX del dominio ──${N}"
    dig +short MX "$DOMAIN" | while IFS= read -r l; do echo -e "  ${G}▸${N} $l"; done
    echo ""
    echo -e "  ${C}── Verificando SPF ──${N}"
    dig +short TXT "$DOMAIN" | grep spf | while IFS= read -r l; do echo -e "  ${G}▸${N} $l"; done
    pause
}

# 15 — Cabecera de Email (analizar)
tool_15() {
    section "15 · Análisis de Cabecera de Email"
    echo -e "  ${Y}Pega las cabeceras del email (termina con línea vacía + ENTER):${N}"
    echo ""
    local HEADERS=""
    while IFS= read -r line; do
        [[ -z "$line" ]] && break
        HEADERS+="$line\n"
    done
    echo -e "$HEADERS" | grep -Ei "received:|from:|reply-to:|x-originating-ip:|message-id:" | \
        while IFS= read -r l; do echo -e "  ${G}▸${N} $l"; done
    pause
}

